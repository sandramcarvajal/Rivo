{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "ConnectionStrings": {
    "RivoDb": "Host=localhost;Port=5432;Database=rivo_db;Username=rivo_user;Password=rivo_password;Pooling=true;Maximum Pool Size=10;Minimum Pool Size=1;"
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SecretKey": "your-super-secret-key-change-in-production-at-least-32-characters-long",
    "Issuer": "rivo-api",
    "Audience": "rivo-client",
    "ExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  }
}
